include README.md requirements.lock requirements-build.lock framework.lock.json
include frontend/package.json frontend/package-lock.json
recursive-include frontend/src *.html *.css *.js
recursive-include frontend/tools *.mjs
recursive-include backend/src/wechat_agent/assets *
